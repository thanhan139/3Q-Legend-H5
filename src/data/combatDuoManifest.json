    "direction": "left side faces right, right side faces left; mirror only after QA (weapon handedness)",
    "VFX_ySort": "back aura < actor < weapon slash < impact numbers < HUD",
    "hit_stop_ms": 45,
    "speed": "drive all tweens, timers, animation FPS and FX timeScale from central battle speed",
    "skip": "cancel timelines and VFX, apply authoritative final state without replaying effects",
    "death": "HP=0 then fade actor/HP/Nộ and delete linked FX; position stays vacant",
    "damage": "VFX callbacks must NEVER apply damage or award rewards; only visualize game-command/Battle Core events"
  }
